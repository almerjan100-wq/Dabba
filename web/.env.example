# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Shared secret code new members must enter to sign up (keep private)
INVITE_CODE=DABBA-XXXXXX
# Random string used for keyed hashes (any long random value)
SERVER_SECRET=change-me
# Optional: your own TURN relay for calls (comma-separated URLs)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
