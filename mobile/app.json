{
  "expo": {
    "name": "Dabba",
    "slug": "dabba",
    "owner": "universalvoicesupports-team",
    "scheme": "dabba",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privatechat.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.privatechat.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1A17"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#1C1A17"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Dabba to record voice notes and make voice calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dabba to send photos from your gallery.",
          "cameraPermission": "Allow Dabba to take photos to send."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dabba to use Face ID to unlock the app and locked chats."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Dabba to use the camera.",
          "microphonePermission": "Allow Dabba to use the microphone for voice calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e06ac0d6-e3b5-4c81-b74d-16f6b0653823"
      }
    }
  }
}
